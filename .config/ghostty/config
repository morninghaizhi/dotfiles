# Ghostty config (ported from ~/.config/wezterm)
# Reload: cmd+shift+,   Docs: ghostty +show-config --default --docs

# Appearance
font-size = 12
theme = light:Tomorrow,dark:TokyoNight Night
background-opacity = 0.85
background-blur = 20
macos-titlebar-style = tabs
window-padding-balance = true

# Behavior
# Only the first window at launch attaches to herdr; later windows/tabs get a plain shell.
# Detach (ctrl+q q) closes that window. Falls back to a login shell if herdr fails to start.
initial-command = /opt/homebrew/bin/herdr || exec /bin/zsh -l
confirm-close-surface = true
copy-on-select = clipboard
shell-integration-features = cursor,sudo,title

# Keybinds — splits live in herdr (prefix ctrl+q), so Ghostty stays a single surface
keybind = super+d=unbind
keybind = super+shift+d=unbind
